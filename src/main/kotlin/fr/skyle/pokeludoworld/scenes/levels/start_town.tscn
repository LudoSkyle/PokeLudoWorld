[node name="Roland" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(632, 56)
display_name = "Roland"
gender = "male"
appearance = "ruin_maniac"
text = "Cette grotte, j'y ai passé vingt ans.|Elle a encore des choses à dire, je le sens."
states = PackedStringArray("bell_register > Tout en bas, près du lac souterrain...|...il y a quelque chose qui accroche la lumière.|Moi, j'y descends plus. Trop de noir, trop de cailloux qui bougent.", "bell_tarnished > Alors c'était ça qui brillait.|Une cloche. Vingt ans que je passe devant.")
forbidden_flag = "bell_hung"

[node name="OdileAfter" parent="World/Entities" instance=ExtResource("4_npc")]
