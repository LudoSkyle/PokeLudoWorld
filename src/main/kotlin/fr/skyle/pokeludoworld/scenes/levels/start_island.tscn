[node name="Runner" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(408, 344)
appearance = "rse_triathlete_m"
facing = Vector2(0, 1)
text = "Pff... pff... Je fais le tour de la place tous les matins.|Ne reste pas au milieu du chemin, je perds mon rythme."
movement = "patrol"
pace = 3.0
route = PackedVector2Array(25, 21, 35, 21, 35, 27, 25, 27)
forbidden_flag = "bell_hung"

[node name="Fisher" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(504, 696)
appearance = "hgss_fisherman"
facing = Vector2(0, 1)
text = "Chut... Ça ne mord pas fort aujourd'hui.|Il paraît qu'il y a de gros poissons au large."
forbidden_flag = "bell_hung"

[node name="Roland" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(184, 520)
display_name = "Roland"
gender = "male"
appearance = "frlg_ruinmaniac"
facing = Vector2(1, 0)
text = "Ces eaux, j'y ai plongé vingt ans.|Elles ont encore des choses à dire, je le sens."
states = PackedStringArray("bell_register > Sous le ponton de l'ouest, là où l'eau est profonde...|...il y a quelque chose qui accroche la lumière.|Moi, je n'y plonge plus. Trop froid, trop de courant.", "bell_tarnished > Alors c'était ça qui brillait.|Une cloche. Vingt ans que je passe au-dessus.")
forbidden_flag = "bell_hung"

[node name="GrassWatcher" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(120, 648)
appearance = "frlg_bugcatcher"
facing = Vector2(0, 1)
text = "Ces herbes sont si hautes qu'on s'y perd.|Je cherche des insectes, mais je n'ai encore rien trouvé."
states = PackedStringArray("bell_hung > Il paraît que c'est toi qui as retrouvé la cloche ! Bravo !|Moi, toujours pas le moindre insecte.")
movement = "wander"
pace = 2.0
wander_layer = "Background/Grass"

[node name="BenchLady" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(200, 232)
appearance = "rse_expert_f"
facing = Vector2(0, 1)
text = "Je viens m'asseoir ici tous les matins.|D'ici, on voit passer tout le village."
states = PackedStringArray("bell_hung > Je viens toujours m'asseoir ici le matin.|Maintenant, j'attends que la cloche sonne pour rentrer.")

[node name="Sunbather" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(632, 600)
appearance = "hgss_swimmer_f"
facing = Vector2(0, 1)
text = "Le sable est chaud, l'eau est fraîche.|Je ne bouge plus d'ici avant la nuit."
states = PackedStringArray("bell_hung > J'ai entendu la cloche depuis ma serviette.|Je n'ai pas bougé pour autant.")

[node name="Swimmer" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(392, 152)
appearance = "hgss_swimmer_m"
facing = Vector2(0, 1)
text = "L'eau de la crique est la plus calme de l'île.|Les vagues se cassent sur les rochers avant d'arriver."
states = PackedStringArray("bell_hung > J'étais dans l'eau quand la cloche a sonné.|J'ai bu la tasse. Ça valait le coup.")

[node name="ShellKid" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(456, 152)
appearance = "hgss_tuber_m"
facing = Vector2(0, 1)
text = "Je cherche des coquillages.|Pour l'instant, j'ai surtout trouvé des cailloux."
states = PackedStringArray("bell_hung > J'ai trouvé un coquillage qui fait le bruit de la cloche !|Bon, il faut l'écouter de très près.")

[node name="Sailor" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(856, 296)
appearance = "hgss_sailor"
facing = Vector2(0, 1)
text = "Tu vois ces rochers, au large ?|Ils ferment toutes les passes.|Aucun bateau n'entre dans la baie, aucun n'en sort."
states = PackedStringArray("bell_hung > Les rochers ferment toujours les passes.|Mais une cloche, ça s'entend du large.|Les bateaux sauront qu'il y a un village ici.")

[node name="Youngster" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(408, 120)
appearance = "hgss_youngster"
facing = Vector2(1, 0)
text = "Le Professeur dit que des Pokémon vivent dans ces herbes.|Sans le mien, je n'ose pas y mettre un pied."
states = PackedStringArray("bell_hung > C'est toi qui as rapporté la cloche ? Tout seul ?|Alors moi, je peux bien entrer dans ces herbes. Demain.")

[node name="Gardener" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(744, 664)
appearance = "hgss_npc_midage_woman"
facing = Vector2(0, 1)
text = "Ici, les fleurs poussent toutes seules.|Je me contente de les regarder."
states = PackedStringArray("bell_hung > Depuis la Veillée, je jardine en fredonnant.|Ma sœur dit que je chante faux. Les fleurs ne se plaignent pas.")

[node name="OdileAfter" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(472, 424)
display_name = "Mémé Odile"
gender = "female"
appearance = "dppt_socialite"
facing = Vector2(0, -1)
text = "J'ai finalement fait le déplacement. Je voulais l'entendre de près.|Merci.|*Kraak* ...MON DOS !!!"
required_flag = "bell_hung"
forbidden_flag = "vigil_over"

[node name="FisherAfter" parent="World/Entities" instance=ExtResource("4_npc")]
