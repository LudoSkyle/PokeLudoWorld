display_name = "Alix"
gender = "female"
appearance = "frlg_aromalady"
facing = Vector2(1, 0)
text = "J'ai fermé la bibliothèque pour ce soir.|Il y a des choses qu'on n'apprend pas dans les livres."
required_flag = "bell_hung"
forbidden_flag = "vigil_over"

[node name="WorkerAfter" parent="World/Entities" instance=ExtResource("4_npc")]
