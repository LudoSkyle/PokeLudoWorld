text = "Ne bouge pas... La lumière sur ce bronze est parfaite."
states = PackedStringArray("vigil_over > Presque fini. Il me manque le reflet sur le bronze.|Les autres sont repartis. Moi, je reste jusqu'au dernier coup de pinceau.")
required_flag = "bell_hung"

[node name="RunnerAfter" parent="World/Entities" instance=ExtResource("4_npc")]
position = Vector2(408, 344)
appearance = "rse_triathlete_m"
