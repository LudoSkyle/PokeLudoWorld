# English translation of PokeLudoWorld.
# The game is written in French: each msgid is a French text exactly as it
# appears in a scene or in the code. Check with tests/run.sh i18n.
msgid ""
msgstr ""
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Grotte - Entrée"
msgstr "Cave - Entrance"

msgid "Grotte - Sous-sol 1"
msgstr "Cave - Basement 1"

msgid "Grotte - Sous-sol 2"
msgstr "Cave - Basement 2"

msgid "Un serveur qui ronronne doucement."
msgstr "A server humming quietly."

msgid "Il a l'air de contenir des données très importantes."
msgstr "It seems to hold very important data."

msgid "Une bibliothèque pleine de livres."
msgstr "A bookshelf full of books."

msgid "Ils ont l'air très intéressants !"
msgstr "They look really interesting!"

msgid "La poubelle est vide."
msgstr "The bin is empty."

msgid "Laboratoire"
msgstr "Laboratory"

msgid "Maison de Ludo"
msgstr "Ludo's House"

msgid "Bibliothèque"
msgstr "Library"

msgid "Bibliothèque de Bourg-Ludo."
msgstr "Bourg-Ludo Library."

msgid "Entrée libre. On parle à voix basse."
msgstr "Free entry. Please keep your voice down."

msgid "Maison de Ludo."
msgstr "Ludo's house."

msgid "La porte n'est jamais fermée, entrez donc."
msgstr "The door is never locked, do come in."

msgid "Désolé, le passage est fermé."
msgstr "Sorry, the way is closed."

msgid "C'est dangereux par là : la route n'est pas encore sûre."
msgstr "It's dangerous over there: the road isn't safe yet."

msgid "Ces herbes sont si hautes qu'on s'y perd."
msgstr "This grass is so tall you could get lost in it."

msgid "Je cherche des insectes, mais je n'ai encore rien trouvé."
msgstr "I'm looking for bugs, but I haven't found any yet."

msgid "Pff... pff... Je fais le tour du village tous les matins."
msgstr "Huff... huff... I run around the village every morning."

msgid "Ne reste pas au milieu du chemin, je perds mon rythme."
msgstr "Don't stand in the middle of the path, I'm losing my pace."

msgid "Chut... Ça ne mord pas fort aujourd'hui."
msgstr "Shh... They're not biting much today."

msgid "Il paraît qu'il y a de gros poissons au fond du lac."
msgstr "They say there are big fish at the bottom of the lake."

msgid "Bourg-Ludo"
msgstr "Ludo Town"

msgid "Vitesse du texte"
msgstr "Text speed"

msgid "Langue"
msgstr "Language"

msgid "Retour"
msgstr "Back"

msgid "Sac"
msgstr "Bag"

msgid "Quitter"
msgstr "Exit"

msgid "L'horloge indique %d h %02d."
msgstr "The clock reads %d:%02d."

msgid "C'est la météo."
msgstr "It's the weather forecast."

msgid "Grand soleil sur tout le village aujourd'hui !"
msgstr "Bright sunshine over the whole village today!"

msgid "Quelques nuages ce soir, mais pas une goutte de pluie."
msgstr "A few clouds tonight, but not a drop of rain."

msgid "Un petit vent frais soufflera sur la côte demain matin."
msgstr "A cool breeze will blow along the coast tomorrow morning."

msgid "Il y a un film à la télé."
msgstr "There's a movie on TV."

msgid "Quatre garçons marchent le long d'une voie ferrée."
msgstr "Four boys are walking along a railway track."

msgid "Je ferais mieux d'y aller aussi."
msgstr "I'd better get going too."

msgid "Deux hommes dansent sur un piano géant."
msgstr "Two men are dancing on a giant piano."

msgid "Bon, il est temps de bouger !"
msgstr "Right, time to get moving!"

msgid "Une émission de cuisine."
msgstr "A cooking show."

msgid "Le chef rate sa crêpe, le public applaudit quand même."
msgstr "The chef drops his pancake, the audience claps anyway."

msgid "Un documentaire sur les grottes de la région."
msgstr "A documentary about the local caves."

msgid "Il paraît qu'on s'y perd facilement."
msgstr "They say it's easy to get lost in them."

msgid "Un jeu télévisé."
msgstr "A game show."

msgid "Le candidat hésite... Ah, mauvaise réponse !"
msgstr "The contestant hesitates... Oh, wrong answer!"

msgid "C'est le journal."
msgstr "It's the news."

msgid "Rien à signaler au village, et c'est très bien comme ça."
msgstr "Nothing to report in the village, and that's just fine."

msgid "Une publicité pour des chaussures de course."
msgstr "An ad for running shoes."

msgid "Avec elles on irait deux fois plus vite, paraît-il."
msgstr "They say you'd go twice as fast in them."

msgid "Sauvegarder"
msgstr "Save"

msgid "Oui"
msgstr "Yes"

msgid "Non"
msgstr "No"

msgid "Temps de jeu"
msgstr "Play time"

msgid "Voulez-vous sauvegarder la partie ?"
msgstr "Would you like to save the game?"

msgid "Une sauvegarde existe déjà.\nVoulez-vous l'écraser ?"
msgstr "There is already a saved file.\nIs it OK to overwrite it?"

msgid "La partie est sauvegardée."
msgstr "The game was saved."

msgid "Objets"
msgstr "Items"

msgid "Objets rares"
msgstr "Key Items"

msgid "Poké Balls"
msgstr "Poké Balls"

msgid "Refermer le sac."
msgstr "Close the bag."

msgid "Potion"
msgstr "Potion"

msgid "Un spray qui soigne les blessures. Il rend quelques forces à qui en a besoin."
msgstr "A spray that heals wounds. It gives a little strength back to whoever needs it."

msgid "Poké Ball"
msgstr "Poké Ball"

msgid "Une capsule que l'on lance pour attraper un Pokémon sauvage."
msgstr "A capsule you throw to catch a wild Pokémon."

msgid "Vieille canne"
msgstr "Old Rod"

msgid "Une canne à pêche usée. Le bois est lisse à force d'avoir servi."
msgstr "A worn fishing rod. The wood is smooth from years of use."

msgid "Carte du village"
msgstr "Village Map"

msgid "Un plan de Bourg-Ludo et de ses environs, dessiné à la main."
msgstr "A hand-drawn map of Ludo Town and its surroundings."

msgid "Des objets de test ont été ajoutés au sac."
msgstr "Test items were added to the bag."

msgid "Super Potion"
msgstr "Super Potion"

msgid "Un spray plus concentré que la Potion. Il soigne les blessures sérieuses."
msgstr "A spray stronger than the Potion. It heals serious wounds."

msgid "Hyper Potion"
msgstr "Hyper Potion"

msgid "Le spray des grands jours. Il remet sur pied presque n'importe qui."
msgstr "The spray for big days. It gets almost anyone back on their feet."

msgid "Antidote"
msgstr "Antidote"

msgid "Un spray qui chasse le poison. À garder sous la main en forêt."
msgstr "A spray that drives out poison. Keep it handy in the forest."

msgid "Rappel"
msgstr "Revive"

msgid "Un éclat doré qui ranime celui qui s'est évanoui."
msgstr "A golden shard that revives someone who has fainted."

msgid "Eau Fraîche"
msgstr "Fresh Water"

msgid "Une eau de source très pure. Elle désaltère et requinque."
msgstr "Very pure spring water. It quenches thirst and perks you up."

msgid "Soda Cool"
msgstr "Soda Pop"

msgid "Une boisson pétillante et sucrée. Elle redonne du tonus."
msgstr "A sweet, fizzy drink. It puts some pep back in you."

msgid "Limonade"
msgstr "Lemonade"

msgid "Une limonade bien fraîche. Rien de tel après une longue marche."
msgstr "A nice cold lemonade. Nothing better after a long walk."

msgid "Vous recevez la Vieille canne !"
msgstr "You received the Old Rod!"

msgid "Vous recevez la Carte du village !"
msgstr "You received the Village Map!"

msgid "Jeter"
msgstr "Toss"

msgid "Annuler"
msgstr "Cancel"

msgid "Objet choisi : %s."
msgstr "%s is selected."

msgid "Combien en jeter ?"
msgstr "Toss out how many?"

msgid "Jeter %s x%d ?"
msgstr "Throw away %s x%d?"

msgid "Vous jetez %s x%d."
msgstr "You threw away %s x%d."

msgid "Registre poussiéreux"
msgstr "Dusty Register"

msgid "Le vieux registre des Veillées. Sa dernière page parle d'une cloche mise à l'abri."
msgstr "The old register of the Vigils. Its last page speaks of a bell put away somewhere safe."

msgid "Bienvenue à la bibliothèque."
msgstr "Welcome to the library."

msgid "Tout ce qui est écrit sur le village est ici."
msgstr "Everything ever written about the village is here."

msgid "La cloche ? Ta grand-mère en parle encore ?"
msgstr "The bell? Your grandmother still talks about it?"

msgid "Le registre des Veillées doit être quelque part dans ces rayons."
msgstr "The register of the Vigils must be somewhere on these shelves."

msgid "Cherche au fond, à gauche : c'est là que dorment les vieux papiers."
msgstr "Look at the back, on the left: that's where the old papers sleep."

msgid "Si tu le trouves, il est à toi. Moi, je ne grimpe plus à l'échelle."
msgstr "If you find it, it's yours. I don't climb the ladder anymore."

msgid "Tu l'as trouvé ! Je le cherchais depuis des années."
msgstr "You found it! I had been looking for it for years."

msgid "Des registres reliés, rangés par année."
msgstr "Bound registers, sorted by year."

msgid "L'un d'eux est beaucoup plus poussiéreux que les autres."
msgstr "One of them is much dustier than the others."

msgid "Vous trouvez le Registre poussiéreux !"
msgstr "You found the Dusty Register!"

msgid "« ...la cloche a été descendue à l'abri pour l'hiver, »"
msgstr "\"...the bell was taken down to shelter for the winter,\""

msgid "« au frais, là où l'eau dort sous la pierre. »"
msgstr "\"in the cool, where the water sleeps under the stone.\""

msgid "« On la remontera pour la Veillée prochaine. »"
msgstr "\"We will bring it back up for the next Vigil.\""

msgid "C'est de là que venait le registre."
msgstr "This is where the register came from."

msgid "Le vide dans la rangée se voit encore."
msgstr "You can still see the gap in the row."

msgid "Cloche ternie"
msgstr "Tarnished Bell"

msgid "Une petite cloche de bronze noircie, sortie de la vase du lac souterrain."
msgstr "A small blackened bronze bell, pulled out of the mud of the underground lake."

msgid "Cloche claire"
msgstr "Clear Bell"

msgid "La cloche de Bourg-Ludo, nettoyée. Son bronze a retrouvé sa couleur."
msgstr "The bell of Bourg-Ludo, cleaned. Its bronze has its colour back."

msgid "Ruban de la Veillée"
msgstr "Vigil Ribbon"

msgid "Le ruban que Mémé Odile portait à la dernière Veillée. Un souvenir."
msgstr "The ribbon Granny Odile wore at the last Vigil. A keepsake."

msgid "Te voilà debout. J'ai gardé du pain pour toi."
msgstr "There you are, up at last. I kept some bread for you."

msgid "Tu as vu le socle vide, sur la place ? Il y avait une cloche dessus."
msgstr "Have you seen the empty stand on the square? There used to be a bell on it."

msgid "On la sonnait le dernier soir de l'été. Tout le village venait."
msgstr "We rang it on the last evening of summer. The whole village came."

msgid "Même les Pokémon descendaient écouter, disait ma mère."
msgstr "Even the Pokémon came down to listen, my mother used to say."

msgid "Personne ne sait où elle est passée."
msgstr "Nobody knows where it went."

msgid "Peut-être qu'Alix, la bibliothécaire, sait quelque chose."
msgstr "Maybe Alix, the librarian, knows something."

msgid "Alors ? Alix t'a trouvé quelque chose ?"
msgstr "Well? Did Alix find something for you?"

msgid "Prends ton temps. Moi, je ne bouge plus d'ici."
msgstr "Take your time. I'm not going anywhere."

msgid "Montrer la cloche à Mémé ?"
msgstr "Show the bell to Granny?"

msgid "Oh..."
msgstr "Oh..."

msgid "Elle est comme dans mon souvenir. Exactement comme ça."
msgstr "It's just as I remember it. Exactly like that."

msgid "Non, garde-la. Mes jambes ne montent plus jusque là-haut."
msgstr "No, keep it. My legs won't carry me up there anymore."

msgid "Tiens, prends aussi ça. Je l'ai porté à la dernière Veillée."
msgstr "Here, take this too. I wore it at the last Vigil."

msgid "Vous recevez le Ruban de la Veillée !"
msgstr "You received the Vigil Ribbon!"

msgid "Allez, va. Et sonne fort, que je l'entende d'ici."
msgstr "Go on, now. And ring it loud, so I can hear it from here."

msgid "Cette grotte, j'y ai passé vingt ans."
msgstr "I spent twenty years in that cave."

msgid "Elle a encore des choses à dire, je le sens."
msgstr "It still has things to say, I can feel it."

msgid "Tout en bas, près du lac souterrain..."
msgstr "All the way down, near the underground lake..."

msgid "...il y a quelque chose qui accroche la lumière."
msgstr "...there is something that catches the light."

msgid "Moi, j'y descends plus. Trop de noir, trop de cailloux qui bougent."
msgstr "I don't go down there anymore. Too dark, too many loose stones."

msgid "Alors c'était ça qui brillait."
msgstr "So that's what was shining."

msgid "Une cloche. Vingt ans que je passe devant."
msgstr "A bell. Twenty years I've been walking past it."

msgid "Quelque chose est à moitié enfoncé dans la vase."
msgstr "Something is half buried in the mud."

msgid "Vous trouvez la Cloche ternie !"
msgstr "You found the Tarnished Bell!"

msgid "Quelque chose file le long de la paroi et disparaît dans le noir."
msgstr "Something darts along the wall and vanishes into the dark."

msgid "Ah, bonjour ! Ne fais pas attention au désordre."
msgstr "Ah, hello! Never mind the mess."

msgid "Je range ce laboratoire depuis des années."
msgstr "I have been tidying this laboratory for years."

msgid "Fais voir ça... Du bronze de l'ancienne mine."
msgstr "Let me see that... Bronze from the old mine."

msgid "On n'en coule plus depuis bien avant moi."
msgstr "Nobody has cast any since long before my time."

msgid "Pose-la dans la machine de soin, là-bas. Elle nettoie tout."
msgstr "Put it in the healing machine over there. It cleans anything."

msgid "Regarde-moi ce bronze. Elle est comme neuve."
msgstr "Look at that bronze. It's as good as new."

msgid "Je me demande quel son elle a."
msgstr "I wonder what it sounds like."

msgid "Une machine de soin."
msgstr "A healing machine."

msgid "Elle n'a personne à soigner."
msgstr "It has no one to heal."

msgid "Poser la Cloche ternie dans la machine ?"
msgstr "Put the Tarnished Bell in the machine?"

msgid "La machine s'allume et chante trois notes."
msgstr "The machine lights up and sings three notes."

msgid "Vous récupérez la Cloche claire !"
msgstr "You got the Clear Bell back!"

msgid "Un socle de pierre. Il manque quelque chose dessus."
msgstr "A stone stand. Something is missing on top of it."

msgid "Accrocher la Cloche claire ?"
msgstr "Hang the Clear Bell?"

msgid "Vous accrochez la cloche. Elle tient."
msgstr "You hang the bell. It holds."

msgid "La cloche est à sa place."
msgstr "The bell is where it belongs."

msgid "Elle bouge un peu quand le vent passe."
msgstr "It sways a little when the wind blows."

msgid "Il paraît que c'est toi qui as retrouvé la cloche ! Bravo !"
msgstr "I hear you're the one who found the bell! Well done!"

msgid "Moi, toujours pas le moindre insecte."
msgstr "As for me, still not a single bug."

msgid "J'ai finalement fait le déplacement. Je voulais l'entendre de près."
msgstr "I made the trip after all. I wanted to hear it up close."

msgid "*Kraak* ...MON DOS !!!"
msgstr "*Crack* ...MY BACK!!!"

msgid "Merci."
msgstr "Thank you."

msgid "J'ai laissé ma canne là-bas. Pour une fois."
msgstr "I left my rod over there. For once."

msgid "J'ai fermé la bibliothèque pour ce soir."
msgstr "I closed the library for tonight."

msgid "Il y a des choses qu'on n'apprend pas dans les livres."
msgstr "Some things you don't learn from books."

msgid "Vingt ans que je passais devant sans la voir."
msgstr "Twenty years I walked past it without seeing it."

msgid "La route de l'ouest est ouverte."
msgstr "The west road is open."

msgid "On a fini juste à temps pour la Veillée."
msgstr "We finished just in time for the Vigil."

msgid "Cette cloche m'a ouvert les yeux !"
msgstr "That bell opened my eyes!"

msgid "J'ai couru dans le mauvais sens pendant dix ans !"
msgstr "I've been running the wrong way for ten years!"

msgid "Les outils sont rangés."
msgstr "The tools are put away."

msgid "Ce soir on ne répare rien : on écoute."
msgstr "Tonight we fix nothing: we listen."

msgid "Je l'ai entendue d'ici, par la fenêtre ouverte."
msgstr "I heard it from here, through the open window."

msgid "Un son clair. Ma machine n'avait jamais aussi bien servi."
msgstr "A clear sound. My machine had never been put to better use."

msgid "On l'entendait depuis la route de l'ouest !"
msgstr "We could hear it from the west road!"

msgid "J'ai traversé toute la forêt pour venir. Ça valait la marche."
msgstr "I crossed the whole forest to come. It was worth the walk."

msgid "Elle est toute petite, la cloche ! Mais elle fait un grand bruit !"
msgstr "The bell is so tiny! But it makes a big sound!"

msgid "Une Veillée ! Ma grand-mère m'en parlait tout le temps."
msgstr "A Vigil! My grandmother talked about them all the time."

msgid "Ne bouge pas... La lumière sur ce bronze est parfaite."
msgstr "Don't move... The light on that bronze is perfect."

msgid "Si j'avais su, j'aurais apporté de quoi nourrir tout ce monde."
msgstr "Had I known, I'd have brought enough to feed all these people."

msgid "Même au dojo, on s'est arrêtés pour écouter."
msgstr "Even at the dojo, we stopped to listen."

msgid "La route de l'ouest s'enfonce dans la forêt."
msgstr "The west road runs deep into the forest."

msgid "Le chemin n'est pas encore tracé au-delà."
msgstr "The way beyond has not been cleared yet."

msgid "Mémé Odile"
msgstr "Granny Odile"

msgid "Alix"
msgstr "Alix"

msgid "Roland"
msgstr "Roland"

msgid "Professeur"
msgstr "Professor"
