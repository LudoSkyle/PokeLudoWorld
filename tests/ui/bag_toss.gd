extends "res://tests/lib.gd"

# Jeter un objet : choisir combien, confirmer, et la liste se met a jour.

func test() -> void:
	await fill_bag()
	await menu_pick("Bag")
	await tap("interact")
	check("un objet ordinaire propose Jeter et Annuler", bag_answers() == ["Jeter", "Annuler"] and bag("Description").text == "Objet choisi : Potion.", str(bag_answers()))
	shot("sac_actions")
	await tap("interact")
	check("Jeter : on demande combien, 1 par defaut", bag("Amount").visible and bag("Amount/Value").text == "x1" and bag("Description").text == "Combien en jeter ?", bag("Amount/Value").text)
	check("la boite d'actions a laisse la place", not bag_choices().visible)
	await tap("ui_up")
	check("Haut : 2", bag("Amount/Value").text == "x2", bag("Amount/Value").text)
	await tap("ui_up")
	check("Haut : 3, le maximum", bag("Amount/Value").text == "x3", bag("Amount/Value").text)
	await tap("ui_up")
	check("Haut au maximum : revient a 1", bag("Amount/Value").text == "x1", bag("Amount/Value").text)
	await tap("ui_down")
	check("Bas a 1 : saute au maximum", bag("Amount/Value").text == "x3", bag("Amount/Value").text)
	await tap("ui_down")
	check("Bas : 2", bag("Amount/Value").text == "x2", bag("Amount/Value").text)
	shot("sac_combien")
	await tap("interact")
	check("on demande confirmation", bag("Description").text == "Jeter Potion x2 ?" and bag_answers() == ["Oui", "Non"] and not bag("Amount").visible, bag("Description").text)
	shot("sac_confirmer")
	await tap("ui_down")
	await tap("interact")
	check("Non : rien n'est jete", bag_rows()[0] == "Potion x3" and not bag_choices().visible, str(bag_rows()))

	await tap("interact")
	await tap("interact")
	await tap("ui_up")
	await tap("interact")
	await tap("interact")
	check("Oui : le message le dit", bag("Description").text == "Vous jetez Potion x2.", bag("Description").text)
	check("la liste montre deja ce qu'il reste", bag_rows()[0] == "Potion x1", str(bag_rows()))
	await tap("ui_down")
	check("le message attend une touche, le curseur ne bouge pas", bag_line() == 0 and bag("Description").text == "Vous jetez Potion x2.")
	await tap("interact")
	check("une touche ramene a la liste", bag("Description").text.begins_with("Un spray qui soigne"), bag("Description").text)

	await tap("interact")
	await tap("interact")
	check("un seul exemplaire : la quantite reste a 1", bag("Amount/Value").text == "x1")
	await tap("ui_down")
	check("Bas avec un seul exemplaire : toujours 1", bag("Amount/Value").text == "x1")
	await tap("interact")
	await tap("interact")
	await tap("interact")
	check("le dernier jete, l'objet quitte la liste", bag_rows()[0] == "Super Potion x4" and bag_line() == 0, str(bag_rows()))

	await tap("interact")
	await tap("interact")
	await tap("menu")
	check("la touche du menu annule le choix de la quantite", not bag("Amount").visible and bag_open() and bag_rows()[0] == "Super Potion x4")
