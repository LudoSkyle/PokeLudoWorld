extends "res://tests/lib.gd"

# Le nom de celui qui parle s'affiche dans un encart au-dessus de la boite, a gauche.

func start() -> Vector2i:
	return Vector2i(35, 12)

func test() -> void:
	await spawn("npc", "Named", Vector2i(35, 11), {"display_name": "Camille", "gender": "female", "text": "Bonjour.|@give:potion Vous recevez une Potion !|Prends-en soin."})
	await spawn("npc", "Nameless", Vector2i(36, 12), {"text": "Je n'ai pas de nom."})
	await spawn("npc", "Man", Vector2i(35, 13), {"display_name": "Basile", "gender": "male", "text": "Salut."})
	await spawn("npc", "Neutral", Vector2i(38, 13), {"display_name": "Le Guide", "text": "Par ici."})
	check("boite fermee : pas d'encart", speaker_name() == "")
	await interact_facing("ui_up")
	await wait_text("Bonjour.")
	check("elle parle : son nom s'affiche", speaker_name() == "Camille", speaker_name())
	check("une femme : en rouge", speaker_color() == "red", speaker_color())
	var tag := speaker_tag()
	check("au-dessus de la boite, colle a elle", tag.position.y + tag.size.y >= box().position.y and tag.position.y < box().position.y)
	check("a gauche", tag.position.x < 200.0 and tag.position.x >= box().position.x)
	check("l'encart a la largeur du nom", tag.size.x > 120.0 and tag.size.x < 330.0, str(tag.size.x))
	shot("nom_encart")
	await tap("interact")
	await wait_text("Vous recevez une Potion !")
	check("le jeu annonce un objet : pas de nom sur cette boite", speaker_name() == "", speaker_name())
	await tap("interact")
	await wait_text("Prends-en soin.")
	check("il reprend la parole : son nom revient", speaker_name() == "Camille", speaker_name())
	await close_box()
	check("dialogue fini : l'encart disparait", speaker_name() == "")
	await interact_facing("ui_right")
	await wait_text("Je n'ai pas de nom.")
	check("un personnage sans nom n'a pas d'encart", box().visible and speaker_name() == "", speaker_name())
	await close_box()
	await interact_facing("ui_down")
	await wait_text("Salut.")
	check("un homme : son nom en bleu", speaker_name() == "Basile" and speaker_color() == "blue", speaker_color())
	shot("nom_bleu")
	await close_box()
	await place(Vector2i(37, 13))
	await interact_facing("ui_right")
	await wait_text("Par ici.")
	check("un nom sans genre : a l'encre du texte", speaker_name() == "Le Guide" and speaker_color() == "ink", speaker_color())
	await close_box()
